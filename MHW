        /* =====================================
           顯示魔物詳細資料
        ===================================== */

        function showMonster(id) {

            const monster = monsters[id];

            if (!monster) return;


            document
                .getElementById("detail-symbol")
                .textContent = monster.symbol;


            document
                .getElementById("detail-name")
                .textContent = monster.name;


            document
                .getElementById("detail-type")
                .textContent = monster.type;


            document
                .getElementById("detail-description")
                .textContent =
                monster.description;


            document
                .getElementById("detail-habit")
                .textContent =
                monster.habit;


            document
                .getElementById("detail-feature")
                .textContent =
                monster.feature;


            document
                .getElementById("detail-area")
                .textContent =
                monster.area;


            document
                .getElementById("detail-tip")
                .textContent =
                monster.tip;


            const detail =
                document.getElementById("monster-detail");


            detail.classList.add("show");


            detail.scrollIntoView({
